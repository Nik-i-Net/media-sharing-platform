meta {
  name: [R2] upload
  type: http
  seq: 3
}

put {
  url: {{R2UploadUrl}}
  body: file
  auth: none
}

headers {
  Content-Length: 7399
  x-amz-checksum-sha256: tHy+QBYYfHYhrrTC4OBdCHsK9UMldZ2VMA3foB6q6DQ=
}

body:json {
  {
    
  }
}

body:file {
  file: @file(assets/image.png) @contentType(image/png)
}

settings {
  encodeUrl: false
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
