meta {
  name: [R2] upload
  type: http
  seq: 3
}

put {
  url: {{R2uploadUrl}}
  body: file
  auth: none
}

headers {
  Content-Length: 7399
}

body:json {
  {
    
  }
}

body:file {
  file: @file(assets/image.png) @contentType(image/png)
}

settings {
  encodeUrl: false
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
