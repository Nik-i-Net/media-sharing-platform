meta {
  name: initiateUploads
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/uploads
  body: json
  auth: inherit
}

body:json {
  {
    "files": [{
      "id": "file_1",
      "fileName": "image",
      "mimeType": "image/png",
      "sizeBytes": 7399,
      "isPublic": true,
      "sha256Hex": "84fd4a56a2b468cfd20326aca82b34a04370a5da6eae19d6e669c9042a886fde"
    }]
  }
}

script:post-response {
  const firstResult = res.body.data[0]
  
  if (res.getStatus() === 201 && firstResult.status === 'upload_required') {
    const {url, headers} = firstResult
    
    bru.setVar('R2.upload-url', url)
    bru.setVar('R2.headers.Content-Type', headers['Content-Type']) 
    bru.setVar('R2.headers.Content-Length', headers['Content-Length']) 
    bru.setVar('R2.headers.x-amz-checksum-sha256', headers['x-amz-checksum-sha256'])
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
