meta {
  name: listUploads
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/uploads?page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
}

script:post-response {
  if (res.getStatus() === 200 && res.body.data[0]) {
    bru.setVar('uploads.firstListedId', res.body.data[0].id)
  }
}

settings {
  encodeUrl: false
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
