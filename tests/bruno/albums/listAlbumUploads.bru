meta {
  name: listAlbumUploads
  type: http
  seq: 7
}

get {
  url: {{BASE_URL}}/albums/:id/uploads?page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
}

params:path {
  id: {{albums.firstListedId}}
}

body:json {
  {
    "name": "album_1",
    "isPublic": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
