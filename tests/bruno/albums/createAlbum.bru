meta {
  name: createAlbum
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/albums
  body: json
  auth: inherit
}

body:json {
  {
    "name": "album_1",
    "isPublic": true
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const id = res.body.data.id
    bru.setVar('albums.createdId', id)
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
