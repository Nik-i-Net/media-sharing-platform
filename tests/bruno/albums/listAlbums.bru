meta {
  name: listAlbums
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/albums?page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
}

body:json {
  {
    "name": "album_1",
    "isPublic": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const first = res.body.data[0]
    if (first) {
      bru.setVar('albums.firstListedId', first.id)
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
