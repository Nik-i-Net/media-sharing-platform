{
  "name": "mediahub",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "debug": "tsx --inspect --env-file=.env.development src/server.ts",
    "test": "vitest",
    "test:gen-assets": "bash tests/assets/gen-assets.sh",
    "test:upload-assets-to-r2": "tsx --env-file=.env.test tests/assets/upload-to-r2.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "services:start": "docker compose --env-file .env.development up -d",
    "services:stop": "docker compose --env-file .env.development stop",
    "psql": "node --env-file=.env.development scripts/psql.js",
    "redis-cli": "node --env-file=.env.development scripts/redis-cli.js",
    "db:push": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:seed": "tsx --env-file=.env.development src/shared/db/drizzle/seeds/index.ts",
    "cron:start": "tsx --env-file=.env.development cron/scheduler.ts"
  },
  "keywords": [],
  "author": "nikinet",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@aws-sdk/client-s3": "3.1000.0",
    "@aws-sdk/s3-request-presigner": "3.1000.0",
    "@redis/client": "5.12.1",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "jose": "6.1.3",
    "node-cron": "4.2.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "stripe": "22.1.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/express-serve-static-core": "5.1.1",
    "@types/node": "24.8.1",
    "@types/pg": "8.20.0",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript/native-preview": "7.0.0-dev.20260501.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
