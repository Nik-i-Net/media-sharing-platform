{
  "name": "media-sharing-app",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps --env-file=.env dist/main.js",
    "test": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "esbuild src/main.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/main.js --sourcemap",
    "knex": "node --env-file=.env --import tsx ./node_modules/knex/bin/cli.js --knexfile ./src/@config/knexfile.ts",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:connect": "node --env-file=.env scripts/db-connect.js"
  },
  "keywords": [],
  "author": "nikinet",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.1.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.18"
  }
}
