{
  "name": "media-sharing-platform",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/bootstrap.ts",
    "debug": "tsx --inspect --env-file=.env src/bootstrap.ts",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "esbuild src/bootstrap.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/main.js --sourcemap",
    "knex": "tsx --env-file=.env node_modules/knex/bin/cli.js --knexfile src/config/knexfile.ts",
    "services:start": "docker compose up -d",
    "services:stop": "docker compose stop",
    "psql": "node --env-file=.env scripts/psql.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/shared/persistence/drizzle/seeds/index.ts"
  },
  "keywords": [],
  "author": "nikinet",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jose": "^6.1.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
